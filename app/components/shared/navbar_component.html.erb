<nav
  class="hanzi-navbar"
  role="navigation"
  aria-label="main navigation"
  x-data="mobileNav(600)"
>
  <div class="hanzi-navbar-inner">
    <%= helpers.link_to root_path, class: "hanzi-brand" do %>
      <span class="hanzi-logo">网</span>
      <strong>HanziTrail</strong>
    <% end %>

    <button
      type="button"
      class="hanzi-nav-toggle"
      aria-label="Toggle navigation"
      :aria-expanded="open.toString()"
      x-show="isMobile"
      @click="toggle()"
    >
      <span class="hanzi-nav-toggle-bar" :class="open && 'hanzi-nav-toggle-bar--open'"></span>
      <span class="hanzi-nav-toggle-bar" :class="open && 'hanzi-nav-toggle-bar--open'"></span>
      <span class="hanzi-nav-toggle-bar" :class="open && 'hanzi-nav-toggle-bar--open'"></span>
    </button>

    <div
      class="hanzi-nav-links"
      x-show="!isMobile || open"
      x-cloak
    >
      <%= nav_link("Cards",  flashcards_path) %>
      <%= nav_link("Review", review_path) %>
      <%= nav_link("Stats",  stats_path) %>

      <% if Current.user %>
        <span class="hanzi-nav-user"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn btn--sm btn--ghost", "@click": "close()" %>
      <% else %>
        <%= nav_link("Sign in", new_session_path) %>
      <% end %>
    </div>
  </div>
</nav>
