<nav
  class="hanzi-navbar"
  role="navigation"
  aria-label="Main navigation"
  data-controller="navbar"
  data-navbar-breakpoint-value="600"
>
  <div class="hanzi-navbar-inner">
    <%= helpers.link_to root_path, class: "hanzi-brand" do %>
      <span class="hanzi-logo">网</span>
      <strong>HanziTrail</strong>
    <% end %>

    <button
      type="button"
      class="hanzi-nav-toggle"
      aria-label="Toggle navigation"
      data-navbar-target="toggle"
      aria-expanded="false"
      data-action="click->navbar#toggle"
    >
      <span class="hanzi-nav-toggle-bar"></span>
      <span class="hanzi-nav-toggle-bar"></span>
      <span class="hanzi-nav-toggle-bar"></span>
    </button>

    <div
      class="hanzi-nav-links"
      data-navbar-target="links"
    >
      <%= nav_link("Cards",  flashcards_path) %>
      <%= nav_link("Review", review_path) %>
      <%= nav_link("Stats",  stats_path) %>

      <% if Current.user %>
        <span class="hanzi-nav-user"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn btn--sm btn--ghost", data: { action: "click->navbar#close" } %>
      <% end %>
    </div>
  </div>
</nav>
