<article id="<%= id %>" class="panel-card mb-5" x-data="{ open: <%= open %> }">
  <button
    type="button"
    class="collapsible-header"
    :aria-expanded="open.toString()"
    aria-controls="<%= id %>-content"
    @click="open = !open"
  >
    <div class="collapsible-header-text">
      <% if show_eyebrow? %>
        <span class="eyebrow"><%= eyebrow %></span>
      <% end %>
      <h2 class="fs-5 mb-0"><%= title %></h2>
    </div>

    <div class="collapsible-header-right">
      <% if show_badge? %>
        <%= badge %>
      <% end %>
      <%# Inline chevron instead of the "▾" text glyph: the character rendered
          at the font's own size/weight and could not be scaled or stroked
          consistently. aria-hidden stays — the button's aria-expanded already
          carries the state. %>
      <span class="collapsible-caret" :class="open && 'collapsible-caret--open'" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m4 6 4 4 4-4" />
        </svg>
      </span>
    </div>
  </button>

  <div id="<%= id %>-content" x-show="open" x-cloak class="collapsible-body">
    <%= content %>
  </div>
</article>
