<%= form_with model: flashcard, class: "pure-form pure-form-stacked" do |form| %>
  <div class="panel-card form-card">
    <h1 class="fs-3 mb-5"><%= flashcard.persisted? ? "Edit flashcard" : "New flashcard" %></h1>

    <% if has_errors? %>
      <div class="notice notice--danger mb-4">
        <p><strong>Please fix the following errors:</strong></p>
        <ul>
          <% error_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="form-section">
      <p class="eyebrow mb-3">Core</p>
      <div class="form-grid--2">
        <label class="field">
          Character
          <%= form.text_field :character, autofocus: true, placeholder: "网络", required: true %>
        </label>
        <label class="field">
          Pinyin
          <%= form.text_field :pinyin, placeholder: "wǎngluò", required: true %>
        </label>
      </div>
      <label class="field">
        Meaning
        <%= form.text_field :meaning, placeholder: "network / web", required: true %>
      </label>
      <label class="field">
        Category
        <%= form.text_field :category, placeholder: "technical" %>
      </label>
    </section>

    <section class="form-section">
      <p class="eyebrow mb-3">Memory aids</p>

      <%# DRY: collapse repeated text-area + char-counter wrappers into a shared component %>
      <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
        form: form,
        attribute: :story,
        char_limit: 2_000,
        rows: 6,
        placeholder: "A web connects many nodes…"
      ) %>
      <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
        form: form,
        attribute: :components,
        char_limit: 1_000,
        rows: 3,
        placeholder: "网 = net; 络 = connection/thread"
      ) %>
      <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
        form: form,
        attribute: :literal_meaning,
        char_limit: 500,
        rows: 2,
        placeholder: "net + connection"
      ) %>
      <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
        form: form,
        attribute: :mnemonic,
        char_limit: 1_000,
        rows: 3,
        placeholder: "Imagine cables forming a giant net."
      ) %>
      <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
        form: form,
        attribute: :usage_note,
        char_limit: 1_000,
        rows: 3,
        placeholder: "Used in words related to internet, networking, and infrastructure."
      ) %>
    </section>

    <div class="flex flex--gap mt-5">
      <%= form.submit class: "btn btn--primary" %>
      <%= link_to "Cancel", flashcards_path, class: "btn btn--ghost" %>
    </div>
  </div>
<% end %>
