<%= form_with model: flashcard do |form| %>
  <% if has_errors? %>
    <div class="notification is-danger">
      <p><strong>Please fix the following errors:</strong></p>
      <ul>
        <% error_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label>
    <%= form.label :character %>
    <%= form.text_field :character, autofocus: true %>
  </label>

  <label>
    <%= form.label :pinyin %>
    <%= form.text_field :pinyin %>
  </label>

  <label>
    <%= form.label :meaning %>
    <%= form.text_field :meaning %>
  </label>

  <label>
    <%= form.label :category %>
    <%= form.text_field :category %>
  </label>

  <%# DRY: collapse repeated text-area + char-counter wrappers into a shared component %>
  <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
    form: form,
    attribute: :story,
    char_limit: 2_000,
    rows: 6,
    placeholder: nil
  ) %>
  <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
    form: form,
    attribute: :components,
    char_limit: 1_000,
    rows: 3,
    placeholder: "网 = net; 络 = connection/thread"
  ) %>
  <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
    form: form,
    attribute: :literal_meaning,
    char_limit: 500,
    rows: 2,
    placeholder: "net + connection"
  ) %>
  <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
    form: form,
    attribute: :mnemonic,
    char_limit: 1_000,
    rows: 3,
    placeholder: "Imagine cables forming a giant net."
  ) %>
  <%= render Flashcards::Form::TextAreaWithCounterComponent.new(
    form: form,
    attribute: :usage_note,
    char_limit: 1_000,
    rows: 3,
    placeholder: "Used in words related to internet, networking, and infrastructure."
  ) %>

  <div class="flex flex--gap mt-4">
    <%= form.submit class: "button primary" %>
    <%= link_to "Cancel", flashcards_path, class: "button is-light" %>
  </div>
<% end %>