<div class="flashcards-header">
  <div>
    <h1>Flashcards</h1>
    <p class="text-soft">Mandarin cards with stories, structure, and technical context.</p>
  </div>

  <div class="text-right">
    <% if helpers.allowed_to?(:new?, Flashcard) %>
      <%= link_to "New flashcard", new_flashcard_path, class: "btn btn--primary" %>
    <% else %>
      <%= link_to "Sign in to create", new_session_path, class: "btn btn--ghost" %>
      <p class="text-dim fs-7 mt-2">
        Browsing and practice are open; editing needs a curator account.
      </p>
    <% end %>
  </div>
</div>
