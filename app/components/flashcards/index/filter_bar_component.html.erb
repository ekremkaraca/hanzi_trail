<article class="flashcard-filters">
  <div class="flashcard-filters-header">
    <div class="flashcard-filters-copy">
      <h2 class="is-size-5">Browse cards</h2>
      <p class="text-soft">
        Filter imported and curated flashcards.
      </p>
    </div>

    <div class="curation-shortcuts">
      <%# DRY: data-driven shortcut links from STORY_STATUS_LINKS %>
      <%= render Flashcards::ShortcutsComponent.new %>
    </div>
  </div>
  <%= form_with url: flashcards_path, method: :get, local: true do |form| %>
    <div class="flashcard-filter-grid">
      <label class="filter-search-field">
        <%= form.label :query, "Search" %>
        <%= form.search_field :query,
              value: query,
              placeholder: "Search character, pinyin, meaning..." %>
      </label>

      <label>
        <%= form.label :source %>
        <%= form.select :source,
              [["All", ""], ["HSK", "hsk"], ["Curated", "curated"]],
              selected: source %>
      </label>

      <label>
        <%= form.label :hsk_level, "HSK" %>
        <%= form.select :hsk_level,
              [["All", ""], ["Old 1", "old-1"]],
              selected: hsk_level %>
      </label>

      <label>
        <%= form.label :category %>
        <%= form.text_field :category,
              value: category,
              placeholder: "technical" %>
      </label>

      <label>
        <%= form.label :story_status, "Story" %>
        <%= form.select :story_status,
              [["All", ""], ["Missing", "missing"], ["Draft", "draft"], ["Curated", "curated"]],
              selected: story_status %>
      </label>

      <div class="filter-actions">
        <%= form.submit "Filter", class: "button primary" %>
        <%= link_to "Clear", flashcards_path, class: "button is-light" %>
      </div>
    </div>
  <% end %>
</article>