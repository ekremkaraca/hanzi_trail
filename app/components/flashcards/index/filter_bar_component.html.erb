<article class="flashcard-filters">
  <div class="flashcard-filters-header">
    <div class="flashcard-filters-copy">
      <h2 class="fs-5">Browse cards</h2>
      <p class="text-soft">
        Filter imported and curated flashcards.
      </p>
    </div>

    <div class="curation-shortcuts">
      <%# DRY: data-driven shortcut links from STORY_STATUS_LINKS %>
      <%= render Flashcards::ShortcutsComponent.new %>
    </div>
  </div>
  <%# Selects auto-submit on change (stimulus-components/auto-submit);
     text fields deliberately do not — typing a query should not fire a
     request per keystroke, Enter and the Filter button stay in charge. %>
  <%= form_with url: flashcards_path, method: :get, local: true, class: "pure-form",
        data: { controller: "auto-submit" } do |form| %>
    <div class="flashcard-filter-grid">
      <label class="filter-search-field">
        <%= form.label :query, "Search" %>
        <%= form.search_field :query,
              value: query,
              placeholder: "Search character, pinyin, meaning..." %>
      </label>

      <label>
        <%= form.label :source %>
        <%= form.select :source,
              [["All", ""], ["HSK", "hsk"], ["Curated", "curated"]],
              { selected: source },
              data: { action: "auto-submit#submit" } %>
      </label>

      <label>
        <%= form.label :hsk_level, "HSK" %>
        <%= form.select :hsk_level,
              hsk_level_options,
              { selected: hsk_level },
              data: { action: "auto-submit#submit" } %>
      </label>

      <label>
        <%= form.label :category %>
        <%= form.text_field :category,
              value: category,
              placeholder: "technical" %>
      </label>

      <label>
        <%= form.label :story_status, "Story" %>
        <%= form.select :story_status,
              [["All", ""], ["Missing", "missing"], ["Draft", "draft"], ["Curated", "curated"]],
              { selected: story_status },
              data: { action: "auto-submit#submit" } %>
      </label>

      <div class="filter-actions">
        <%= form.submit "Filter", class: "btn btn--primary" %>
        <%= link_to "Clear", flashcards_path, class: "btn btn--ghost" %>
      </div>
    </div>
  <% end %>
</article>
