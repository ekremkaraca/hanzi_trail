<div class="flashcards-page">
  <%= render Flashcards::Index::HeaderComponent.new %>

  <%= render Flashcards::Index::FilterBarComponent.new(params: params) %>

  <div class="flashcards-table-card">
    <% if any_flashcards? %>
      <table class="pure-table flashcards-table">
        <thead>
          <tr>
            <th>Card</th>
            <th>Meaning</th>
            <th>Meta</th>
            <th>Review</th>
          </tr>
        </thead>

        <tbody>
          <% flashcards.each do |flashcard| %>
            <%= render Flashcards::RowComponent.new(flashcard: flashcard) %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render Flashcards::EmptyStateComponent.new(story_status: story_status) %>
    <% end %>
  </div>

  <% if show_previous? || has_more %>
    <nav class="flashcards-pagination flex flex--gap mt-4">
      <% if show_previous? %>
        <%= link_to "← Previous",
              flashcards_path(page_params(current_page - 1)),
              class: "btn btn--sm btn--ghost" %>
      <% end %>
      <% if has_more %>
        <%= link_to "Next →",
              flashcards_path(page_params(current_page + 1)),
              class: "btn btn--sm btn--ghost" %>
      <% end %>
    </nav>
  <% end %>
</div>