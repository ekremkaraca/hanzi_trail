<div data-controller="char-counter" data-char-counter-limit-value="<%= char_limit %>" class="field">
  <label for="<%= field_id %>"><%= attribute.to_s.humanize %></label>
  <%= form.text_area attribute,
        rows: rows,
        placeholder: placeholder,
        id: field_id,
        data: { "char-counter-target": "field" } %>
  <p
    class="char-counter text-right"
    data-char-counter-target="count"
    data-char-counter-warning-class="char-counter--warning"
  >
    0 / <%= char_limit %>
  </p>
</div>
