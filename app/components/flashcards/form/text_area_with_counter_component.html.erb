<div x-data="textCounter(<%= char_limit %>)" class="field">
  <label for="<%= field_id %>"><%= attribute.to_s.humanize %></label>
  <%= form.text_area attribute,
        rows: rows,
        placeholder: placeholder,
        "x-ref": "field" %>
  <p
    class="char-counter text-right"
    :class="overLimit && 'char-counter--warning'"
  >
    <span x-text="count"></span> / <%= char_limit %>
  </p>
</div>
