<%# DRY: session-progress primary line; sits above the bar as a single, focused number. %>
<div class="review-progress-card">
  <p class="review-progress-label">
    <span><%= reviewed_count %> reviewed · <%= remaining_due_count %> remaining</span>
    <span class="review-progress-percent"><%= progress %>%</span>
  </p>

  <progress
    class="is-info"
    value="<%= progress %>"
    max="100"
    aria-label="Review progress: <%= progress %>%"
  ></progress>

  <%# DRY: secondary metrics (today + queue) sit below the bar as muted context. %>
  <p class="review-progress-meta">
    <span>Today: <strong><%= reviewed_today_count %></strong></span>
    <span>Queue: <strong><%= remaining_due_count %></strong></span>
  </p>
</div>
