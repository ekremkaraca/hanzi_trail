<div x-show="answerVisible" x-cloak class="review-answer-section">
  <%# DRY: pinyin + meaning header pulled out of inline styles into a class %>
  <header class="review-meaning-header">
    <p class="pinyin"><%= flashcard.pinyin %></p>
    <h2 class="meaning"><%= flashcard.meaning %></h2>
  </header>

  <div x-data="{ activeTab: 0 }" class="review-tab-panels">
    <%# The component now builds tab controls directly so panel markup stays local. %>
    <ul class="tabs" role="tablist">
      <% tabs.each do |tab| %>
        <li
          data-index="<%= tab.fetch(:index) %>"
          @click="activeTab = <%= tab.fetch(:index) %>"
        >
          <a
            role="tab"
            tabindex="0"
            :aria-selected="activeTab === <%= tab.fetch(:index) %>"
            @click.prevent="activeTab = <%= tab.fetch(:index) %>"
          >
            <%= tab.fetch(:label) %>
          </a>
        </li>
      <% end %>
    </ul>

    <% tabs.each do |tab| %>
      <div class="review-tab-panel" role="tabpanel" x-show="activeTab === <%= tab.fetch(:index) %>">
        <%= render tab.fetch(:component).new(flashcard: flashcard) %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4">
    <%= link_to "Explore card", flashcard_path(flashcard), class: "button is-dark is-outlined is-small" %>
  </div>
</div>
