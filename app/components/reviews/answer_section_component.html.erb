<div x-show="answerVisible" x-cloak class="review-answer-section">
  <%# DRY: pinyin + meaning header pulled out of inline styles into a class %>
  <header class="review-meaning-header">
    <p class="pinyin"><%= flashcard.pinyin %></p>
    <h2 class="meaning"><%= flashcard.meaning %></h2>
  </header>

  <div data-controller="tabs" data-tabs-default-index-value="0" class="review-tab-panels">
    <%# The component now builds tab controls directly so panel markup stays local. %>
    <ul class="tabs" role="tablist">
      <% tabs.each_with_index do |tab, index| %>
        <li
          data-index="<%= index %>"
          data-action="click->tabs#select"
        >
          <a
            role="tab"
            href="#review-tab-<%= index %>-panel"
            id="review-tab-<%= index %>-tab"
            aria-controls="review-tab-<%= index %>-panel"
            tabindex="<%= index == 0 ? 0 : -1 %>"
            aria-selected="<%= index == 0 ? 'true' : 'false' %>"
            data-tabs-target="tab"
            data-action="click->tabs#select"
          >
            <%= tab.fetch(:label) %>
          </a>
        </li>
      <% end %>
    </ul>

    <% tabs.each_with_index do |tab, index| %>
      <div
        class="review-tab-panel"
        role="tabpanel"
        id="review-tab-<%= index %>-panel"
        aria-labelledby="review-tab-<%= index %>-tab"
        data-tabs-target="panel"
        <% unless index == 0 %>hidden<% end %>
      >
        <%= render tab.fetch(:component).new(flashcard: flashcard) %>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-4">
    <%= link_to "Explore card", flashcard_path(flashcard), class: "btn btn--dark btn--outline btn--sm" %>
  </div>
</div>
