<%# DRY: negative side margins let the actions escape the .review-card padding and span the full page width %>
<div class="mt-auto pt-5" x-show="answerVisible" x-cloak>
  <div class="review-buttons grid mb-2 review-buttons--bleed">
    <%= rating_buttons %>
  </div>
  <small class="d-block text-center mt-2">
    <%# DRY: shortcut hint text driven by REVIEW_BUTTONS keys %>
    Use <%= shortcut_keys %> keys for quick review
  </small>
</div>
