<%# The preference row must stay reachable on every viewport: it used to carry
   hidden-mobile, which made the only control for "show pinyin before answer"
   display:none below 768px, so phones could never change a curator-set
   session value. The route helper is used instead of the literal path so the
   form cannot drift from routes.rb (review_reset_path already does this). %>
<div class="review-preferences text-center mt-4">
  <%= form_with url: review_preferences_path, method: :patch, class: "pure-form" do |form| %>
    <label class="checkbox fs-7 text-dim mr-2">
      <%= form.check_box :show_pinyin, checked: show_pinyin %>
      Show pinyin before answer
    </label>

    <%= hidden_field_tag :source, filter_params[:source] %>
    <%= hidden_field_tag :category, filter_params[:category] %>
    <%= hidden_field_tag :story_status, filter_params[:story_status] %>

    <%= form.submit "Save", class: "btn btn--sm btn--dark" %>
  <% end %>
</div>
