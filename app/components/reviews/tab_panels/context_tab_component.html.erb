<div class="review-tab-panel-card">
  <div class="content is-size-6 text-white-ter">
    <%# DRY: usage note rendered the same way as the story text via shared component %>
    <%= render Reviews::CharacterLabelComponent.new(
      flashcard: flashcard,
      attribute: :usage_note,
      label: "Usage Note",
      color: "warning"
    ) %>

    <% if flashcard.character_entries.any? %>
      <p class="mt-3 mb-1">
        <span class="is-size-7 text-grey text-uppercase tracking-wide">Components</span>
      </p>
      <p>
        <%# DRY: use shared ordered_characters association to keep ordering in one place %>
        <% flashcard.ordered_characters.each do |link| %>
          <span class="mx-1"><%= link.character_entry.character %></span>
        <% end %>
        &middot; <%= link_to "Explore characters →", flashcard_path(flashcard, anchor: "characters"), class: "text-link" %>
      </p>
    <% end %>
  </div>
</div>