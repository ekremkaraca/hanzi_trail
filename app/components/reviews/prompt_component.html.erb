<div class="review-prompt text-center mb-5">
  <h1 class="review-character text-bright mb-2" data-review-target="character">
    <%= flashcard.character %>
  </h1>

  <% if show_pinyin %>
    <p class="fs-4 text-dim mt-0">
      <%= flashcard.pinyin %>
    </p>
  <% end %>

  <div class="flex flex--center flex--gap mt-5">
    <button
      type="button"
      class="btn btn--primary"
      @click="window.dispatchEvent(new Event('review:toggle'))"
      x-text="answerVisible ? 'Hide answer' : 'Show answer'"
    ></button>
    <%# Inline SVG instead of an emoji: 🔊 rendered as a full-colour OS glyph
        that ignored the button's text colour and shifted size per platform.
        stroke="currentColor" keeps it in the btn--dark palette, and
        aria-hidden stops a screen reader announcing a second, redundant label. %>
    <button
      type="button"
      class="btn btn--dark btn--icon"
      data-review-target="speakButton"
      data-action="click->review#speak"
    >
      <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M11 5 6.5 9H3v6h3.5L11 19V5Z" />
        <path d="M15.5 8.5a5 5 0 0 1 0 7" />
        <path d="M18.5 5.5a9 9 0 0 1 0 13" />
      </svg>
      Speak
    </button>
  </div>

  <%# Revealed by the Stimulus controller when the browser has no Mandarin
      voice: hanzi read by a non-Chinese voice is mispronounced, so the
      button is disabled and the reason is explained instead. %>
  <div class="review-voice-hint text-dim fs-7 mt-3" data-review-target="voiceHint" hidden>
    <p class="mb-1">
      This browser has no Mandarin voice, so characters cannot be spoken.
    </p>
    <details>
      <summary>How to add one</summary>
      <ul class="mt-1">
        <li>macOS: System Settings → Accessibility → Spoken Content → System Voices → Chinese</li>
        <li>Windows: Settings → Time &amp; language → Language &amp; region → Chinese → Language options → Speech</li>
        <li>Linux: install a Chinese speech-dispatcher voice (for example <code>speech-dispatcher-espeak-ng</code>)</li>
      </ul>
    </details>
  </div>
</div>
