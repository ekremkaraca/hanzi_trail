<div class="review-prompt text-center mb-5">
  <h1 class="review-character text-bright mb-2" data-review-target="character">
    <%= flashcard.character %>
  </h1>

  <% if show_pinyin %>
    <p class="fs-4 text-dim mt-0">
      <%= flashcard.pinyin %>
    </p>
  <% end %>

  <div class="flex flex--center flex--gap mt-5">
    <button
      type="button"
      class="btn btn--primary"
      @click="window.dispatchEvent(new Event('review:toggle'))"
      x-text="answerVisible ? 'Hide answer' : 'Show answer'"
    ></button>
    <%# Inline SVG instead of an emoji: 🔊 rendered as a full-colour OS glyph
        that ignored the button's text colour and shifted size per platform.
        stroke="currentColor" keeps it in the btn--dark palette, and
        aria-hidden stops a screen reader announcing a second, redundant label. %>
    <button
      type="button"
      class="btn btn--dark btn--icon"
      data-review-target="speakButton"
      data-action="click->review#speak"
      aria-describedby="review-voice-hint"
    >
      <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M11 5 6.5 9H3v6h3.5L11 19V5Z" />
        <path d="M15.5 8.5a5 5 0 0 1 0 7" />
        <path d="M18.5 5.5a9 9 0 0 1 0 13" />
      </svg>
      Speak
    </button>
  </div>

  <%# Revealed by the Stimulus controller when the browser has no Mandarin
      voice: hanzi read by a non-Chinese voice is mispronounced, so the
      button is disabled and the reason is explained instead. The hint ships
      hidden, so the aria-describedby link only resolves once it is shown —
      which is exactly when the disabled button needs the explanation. %>
  <div
    class="review-voice-hint"
    id="review-voice-hint"
    data-review-target="voiceHint"
    hidden
  >
    <svg class="review-voice-hint-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M11 5 6.5 9H3v6h3.5L11 19V5Z" />
      <path d="m16 9.5 5 5" />
      <path d="m21 9.5-5 5" />
    </svg>

    <div>
      <p class="review-voice-hint-title">
        This browser has no Mandarin voice, so characters cannot be spoken.
      </p>

      <details class="review-voice-hint-steps">
        <summary>
          <span>How to add one</span>
          <svg class="review-voice-hint-caret" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>

        <%# Two-column definition list: the OS name becomes a scannable left
            column instead of a centred bullet with a ragged path after it. %>
        <dl>
          <dt>macOS</dt>
          <dd>System Settings → Accessibility → Spoken Content → System Voices → Chinese</dd>

          <dt>Windows</dt>
          <dd>Settings → Time &amp; language → Language &amp; region → Chinese → Language options → Speech</dd>

          <dt>Linux</dt>
          <dd>Install a Chinese speech-dispatcher voice, e.g. <code>speech-dispatcher-espeak-ng</code></dd>
        </dl>
      </details>
    </div>
  </div>
</div>
