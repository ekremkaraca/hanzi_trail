<%= render Shared::CollapsibleBoxComponent.new(
      id: "most-difficult",
      title: "Most Difficult Cards",
      badge: badge
    ) do %>
  <% if any_cards? %>
    <div class="stack">
      <% difficult_cards.each do |card| %>
        <%= link_to flashcard_path(card), class: "stack-row difficult-card-item" do %>
          <span class="fw-semibold mr-3"><%= card.character %></span>
          <span class="flex--grow"><%= card.meaning %></span>
          <span class="badge badge--warning"><%= pluralize(card.difficult_review_count, "hard review") %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-dim">No difficult cards yet.</p>
  <% end %>
<% end %>
