<%= render Shared::CollapsibleBoxComponent.new(
      id: "recently-reviewed",
      title: "Recently reviewed"
    ) do %>
  <% if any_attempts? %>
    <figure style="overflow-x: auto; margin: 0;">
      <table>
        <tbody>
          <% display_attempts.each do |attempt| %>
            <tr class="stats-list-item">
              <td class="stats-list-character"><%= attempt.flashcard.character %></td>
              <td><span class="badge badge--neutral cap"><%= attempt.rating %></span></td>
              <td class="text-dim text-right"><%= reviewed_ago(attempt) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </figure>
  <% else %>
    <p class="text-dim">No reviews yet.</p>
  <% end %>
<% end %>
