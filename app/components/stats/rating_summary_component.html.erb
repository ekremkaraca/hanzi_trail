<%= render Shared::CollapsibleBoxComponent.new(
      id: "rating-summary",
      title: "Review counts by rating"
    ) do %>
  <div class="grid grid--stats">
    <% ratings.each do |rating| %>
      <div class="notification is-light text-center">
        <p class="stats-card-label"><%= rating.capitalize %></p>
        <strong class="stats-card-value"><%= count_for(rating) %></strong>
      </div>
    <% end %>
  </div>
<% end %>
