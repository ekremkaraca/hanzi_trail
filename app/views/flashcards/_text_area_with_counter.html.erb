<%# Locals:
    form       - the form builder instance (e.g. `form`)
    attribute  - the attribute symbol (e.g. :story)
    char_limit - the soft cap (matches the model validation)
    rows       - text_area rows
    placeholder - optional placeholder text
%>
<div x-data="textCounter(<%= char_limit %>)">
  <label>
    <%= form.label attribute %>
    <%= form.text_area attribute,
          rows: rows,
          placeholder: placeholder,
          "x-ref": "field" %>
  </label>
  <%= render "shared/char_counter", field: form, attribute: attribute, char_limit: char_limit %>
</div>
