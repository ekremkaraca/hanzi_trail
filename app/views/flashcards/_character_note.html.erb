<%# Locals:
    flashcard - the Flashcard instance
    attribute  - the attribute symbol (e.g. :components)
    title      - the heading text shown above the formatted text
%>
<% if flashcard.public_send(attribute).present? %>
  <div class="flashcard-note">
    <h3><%= title %></h3>
    <%= simple_format(flashcard.public_send(attribute)) %>
  </div>
<% end %>
