<section class="section flashcards-page">
  <div class="container is-max-widescreen">
    <div class="flashcards-header">
      <div>
        <h1 class="title is-2">Flashcards</h1>
        <p class="subtitle is-6 has-text-grey-light">
          Mandarin cards with stories, structure, and technical context.
        </p>
      </div>

      <button class="button is-primary" disabled title="Disabled until authentication is added">
        New flashcard
      </button>
      <p class="has-text-grey-light is-size-7 mt-2">
        Editing is disabled until authentication is added.
      </p>
    </div>

    <div class="flashcard-filters box">
      <div class="flashcard-filters-header">
        <div class="flashcard-filters-copy">
          <h2 class="title is-5">Browse cards</h2>
          <p class="has-text-grey-light">
            Filter imported and curated flashcards.
          </p>
        </div>

        <div class="curation-shortcuts">
          <%= link_to "Missing stories", flashcards_path(story_status: "missing"), class: "button is-warning is-light" %>
          <%= link_to "Draft stories", flashcards_path(story_status: "draft"), class: "button is-info is-light" %>
          <%= link_to "Curated stories", flashcards_path(story_status: "curated"), class: "button is-success is-light" %>
          <%= link_to "Short stories", flashcards_path(story_status: "short"), class: "button is-light" %>
        </div>
      </div>
      <%= form_with url: flashcards_path, method: :get, local: true do |form| %>
        <div class="flashcard-filter-grid">
          <div class="field filter-search-field">
            <%= form.label :query, "Search", class: "label" %>
            <%= form.search_field :query,
                  value: params[:query],
                  placeholder: "Search character, pinyin, meaning...",
                  class: "input" %>
          </div>

          <div class="field">
            <%= form.label :source, class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :source,
                    [["All", ""], ["HSK", "hsk"], ["Curated", "curated"]],
                    selected: params[:source] %>
            </div>
          </div>

          <div class="field">
            <%= form.label :hsk_level, "HSK", class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :hsk_level,
                    [["All", ""], ["Old 1", "old-1"]],
                    selected: params[:hsk_level] %>
            </div>
          </div>

          <div class="field">
            <%= form.label :category, class: "label" %>
            <%= form.text_field :category,
                  value: params[:category],
                  placeholder: "technical",
                  class: "input" %>
          </div>

          <div class="field">
            <%= form.label :story_status, "Story", class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :story_status,
                    [["All", ""], ["Missing", "missing"], ["Draft", "draft"], ["Curated", "curated"]],
                    selected: params[:story_status] %>
            </div>
          </div>

          <div class="filter-actions">
            <%= form.submit "Filter", class: "button is-primary" %>
            <%= link_to "Clear", flashcards_path, class: "button is-light" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flashcards-table-card">
      <% if @flashcards.any? %>
        <table class="table is-fullwidth flashcards-table">
          <thead>
            <tr>
              <th>Card</th>
              <th>Meaning</th>
              <th>Meta</th>
              <th>Review</th>
            </tr>
          </thead>

          <tbody>
            <% @flashcards.each do |flashcard| %>
              <tr>
                <td class="flashcard-card-cell">
                  <%= link_to flashcard.character, flashcard_path(flashcard), class: "flashcard-character-link" %>
                  <span class="flashcard-pinyin"><%= flashcard.pinyin %></span>
                </td>

                <td class="flashcard-meaning-cell">
                  <%= truncate(flashcard.meaning, length: 120) %>
                </td>

                <td>
                  <div class="tags are-small">
                    <% if flashcard.category.present? %>
                      <span class="tag is-dark"><%= flashcard.category %></span>
                    <% end %>

                    <span class="tag is-link is-light">
                      <%= flashcard.source.presence || "curated" %>
                    </span>

                    <% if flashcard.hsk_level.present? %>
                      <span class="tag is-info is-light"><%= flashcard.hsk_level %></span>
                    <% end %>

                    <%= story_status_tag(flashcard) %>
                    <%= story_quality_tag(flashcard) %>
                  </div>
                </td>

                <td class="flashcard-review-cell">
                  <strong><%= flashcard.review_count %></strong>
                  <span class="has-text-grey-light">reviews</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="flashcards-empty-state">
          <div class="flashcards-empty-icon">
            ◈
          </div>

          <h2 class="flashcards-empty-title">
            <%= flashcards_empty_title %>
          </h2>

          <p class="flashcards-empty-text">
            Draft stories will appear here once imported or curated flashcards gain initial story content.
          </p>

          <div class="flashcards-empty-actions">
            <%= link_to "View missing stories",
                  flashcards_path(story_status: "missing"),
                  class: "button is-warning is-light" %>

            <%= link_to "Browse all flashcards",
                  flashcards_path,
                  class: "button is-light" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
