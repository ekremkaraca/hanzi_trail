<section class="section flashcards-page">
  <div class="container is-max-widescreen">
    <div class="flashcards-header">
      <div>
        <h1 class="title is-2">Flashcards</h1>
        <p class="subtitle is-6 has-text-grey-light">
          Mandarin cards with stories, structure, and technical context.
        </p>
      </div>

      <%= link_to "New flashcard", new_flashcard_path, class: "button is-primary" %>
    </div>

    <div class="flashcard-filters box">
      <%= form_with url: flashcards_path, method: :get, local: true do |form| %>
        <div class="columns is-vcentered">
          <div class="column">
            <%= form.label :source, class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :source,
                    [["All", ""], ["HSK", "hsk"], ["Curated", "curated"]],
                    selected: params[:source] %>
            </div>
          </div>

          <div class="column">
            <%= form.label :hsk_level, "HSK Level", class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :hsk_level,
                    [["All", ""], ["Old 1", "old-1"]],
                    selected: params[:hsk_level] %>
            </div>
          </div>

          <div class="column is-3">
            <%= form.label :category, class: "label" %>
            <%= form.text_field :category,
                  value: params[:category],
                  placeholder: "e.g. technical",
                  class: "input" %>
          </div>

          <div class="column">
            <%= form.label :story_status, "Story", class: "label" %>
            <div class="select is-fullwidth">
              <%= form.select :story_status,
                    [["All", ""], ["Missing", "missing"], ["Draft", "draft"], ["Curated", "curated"]],
                    selected: params[:story_status] %>
            </div>
          </div>

          <div class="column is-narrow flashcard-filter-actions">
            <%= form.submit "Filter", class: "button is-primary" %>
            <%= link_to "Clear", flashcards_path, class: "button is-light" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flashcards-table-card">
      <table class="table is-fullwidth flashcards-table">
        <thead>
          <tr>
            <th>Card</th>
            <th>Meaning</th>
            <th>Meta</th>
            <th>Review</th>
          </tr>
        </thead>

        <tbody>
          <% @flashcards.each do |flashcard| %>
            <tr>
              <td class="flashcard-card-cell">
                <%= link_to flashcard.character, flashcard_path(flashcard), class: "flashcard-character-link" %>
                <span class="flashcard-pinyin"><%= flashcard.pinyin %></span>
              </td>

              <td class="flashcard-meaning-cell">
                <%= truncate(flashcard.meaning, length: 120) %>
              </td>

              <td>
                <div class="tags are-small">
                  <% if flashcard.category.present? %>
                    <span class="tag is-dark"><%= flashcard.category %></span>
                  <% end %>

                  <span class="tag is-link is-light">
                    <%= flashcard.source.presence || "curated" %>
                  </span>

                  <% if flashcard.hsk_level.present? %>
                    <span class="tag is-info is-light"><%= flashcard.hsk_level %></span>
                  <% end %>

                  <span class="tag is-warning is-light">
                    <%= flashcard.story_status.humanize %>
                  </span>
                </div>
              </td>

              <td class="flashcard-review-cell">
                <strong><%= flashcard.review_count %></strong>
                <span class="has-text-grey-light">reviews</span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>