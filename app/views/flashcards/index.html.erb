<section class="section">
  <div class="container">
    <div class="level">
      <div>
        <h1 class="title">Flashcards</h1>
        <p class="subtitle">Mandarin cards with stories and technical context.</p>
      </div>

      <%= link_to "New flashcard", new_flashcard_path, class: "button is-primary" %>
    </div>

    <%= form_with url: flashcards_path, method: :get, local: true, class: "box" do |form| %>
      <div class="columns is-align-items-flex-end">
        <div class="column">
          <%= form.label :source, "Source", class: "label" %>
          <%= form.select :source, [["All", ""], ["HSK", "hsk"], ["Curated", "curated"]], selected: params[:source], class: "select" %>
        </div>

        <div class="column">
          <%= form.label :hsk_level, "HSK Level", class: "label" %>
          <%= form.select :hsk_level, [["All", ""], ["Old 1", "old-1"]], selected: params[:hsk_level], class: "select" %>
        </div>

        <div class="column">
          <%= form.label :category, "Category", class: "label" %>
          <%= form.text_field :category, value: params[:category], class: "input", placeholder: "e.g. radicals, verbs, etc." %>
        </div>

        <div class="column">
          <%= form.label :story_status, "Story", class: "label" %>
          <%= form.select :story_status, [["All", ""], ["Missing", "missing"], ["Draft", "draft"], ["Curated", "curated"]], selected: params[:story_status], class: "select" %>
        </div>

        <div class="column is-narrow">
          <div class="field is-grouped">
            <div class="control">
              <%= form.submit "Filter", class: "button is-primary" %>
            </div>
            <div class="control">
              <%= link_to "Clear", flashcards_path(source: "", hsk_level: "", category: "", story_status: "", commit: "Filter"), class: "button is-light" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="table-container">
      <table class="table is-fullwidth is-hoverable">
        <thead>
          <tr>
            <th>Character</th>
            <th>Pinyin</th>
            <th>Meaning</th>
            <th>Category</th>
            <th>Source</th>
            <th>HSK Level</th>
            <th>Story</th>
            <th>Review count</th>
          </tr>
        </thead>

        <tbody>
          <% @flashcards.each do |flashcard| %>
            <tr>
              <td class="is-size-4"><%= link_to flashcard.character, flashcard %></td>
              <td><%= flashcard.pinyin %></td>
              <td><%= flashcard.meaning %></td>
              <td><%= flashcard.category %></td>
              <td><%= flashcard.source %></td>
              <td><%= flashcard.hsk_level %></td>
              <td>
                <% if flashcard.story_status == "curated" %>
                  <span class="tag is-success">Curated story</span>
                <% else %>
                  <span class="tag"><%= flashcard.story_status.to_s.humanize %></span>
                <% end %>
              </td>
              <td><%= flashcard.review_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
