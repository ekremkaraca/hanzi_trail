<%= form_with model: flashcard do |form| %>
  <% if flashcard.errors.any? %>
    <div class="notification is-danger">
      <p><strong>Please fix the following errors:</strong></p>
      <ul>
        <% flashcard.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label>
    <%= form.label :character %>
    <%= form.text_field :character, autofocus: true %>
  </label>

  <label>
    <%= form.label :pinyin %>
    <%= form.text_field :pinyin %>
  </label>

  <label>
    <%= form.label :meaning %>
    <%= form.text_field :meaning %>
  </label>

  <label>
    <%= form.label :category %>
    <%= form.text_field :category %>
  </label>

  <%# DRY: collapse repeated text-area + char-counter wrappers into a shared partial %>
  <%= render "text_area_with_counter", form: form, attribute: :story, char_limit: 2_000, rows: 6, placeholder: nil %>
  <%= render "text_area_with_counter", form: form, attribute: :components, char_limit: 1_000, rows: 3, placeholder: "网 = net; 络 = connection/thread" %>
  <%= render "text_area_with_counter", form: form, attribute: :literal_meaning, char_limit: 500, rows: 2, placeholder: "net + connection" %>
  <%= render "text_area_with_counter", form: form, attribute: :mnemonic, char_limit: 1_000, rows: 3, placeholder: "Imagine cables forming a giant net." %>
  <%= render "text_area_with_counter", form: form, attribute: :usage_note, char_limit: 1_000, rows: 3, placeholder: "Used in words related to internet, networking, and infrastructure." %>

  <div class="flex flex--gap mt-4">
    <%= form.submit class: "button primary" %>
    <%= link_to "Cancel", flashcards_path, class: "button is-light" %>
  </div>
<% end %>