<div class="session-page">
  <article class="panel-card session-card">
    <h1 class="fs-4 mb-3">Sign in</h1>
    <p class="text-soft mb-4">Curator access — browsing and practice stay open to everyone.</p>

    <%= form_with url: session_path, class: "pure-form pure-form-stacked session-form" do |form| %>
      <label class="field">
        Email
        <%# QueryParam.scalar: /session?email_address[]=x would otherwise echo
            the array's to_s (["x"]) back into the value attribute.
        %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: QueryParam.scalar(params[:email_address]) %>
      </label>
      <label class="field">
        Password
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72 %>
      </label>
      <%= form.submit "Sign in", class: "btn btn--primary btn--block" %>
    <% end %>
  </article>
</div>
