<!DOCTYPE html>
<html>
  <head>
    <title>HanziTrail</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar is-white hanzi-navbar" role="navigation">
      <div class="navbar-brand">
        <%= link_to root_path, class: "navbar-item hanzi-brand" do %>
          <span class="hanzi-logo">网</span>
          <strong>HanziTrail</strong>
        <% end %>
      </div>

      <div class="navbar-menu is-active">
        <div class="navbar-start">
          <%= link_to "Cards", flashcards_path, class: "navbar-item" %>
          <%= link_to "Review", review_path, class: "navbar-item" %>
        </div>
      </div>
    </nav>

    <%= render "shared/flash" %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>