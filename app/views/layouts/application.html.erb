<!DOCTYPE html>
<html>
  <head>
    <title>HanziTrail</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "vendor/pure-min", "vendor/grids-responsive-min", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
        <%= render Shared::NavbarComponent.new %>
    </header>
    <main class="container">
        <%= render Shared::FlashComponent.new %>
        <%= yield %>
    </main>
    <footer>
        <%= render Shared::FooterComponent.new %>
    </footer>
  </body>
</html>
