<div class="review-prompt text-center mb-5">
  <h1 class="review-character text-white mb-2" data-review-target="character">
    <%= flashcard.character %>
  </h1>

  <% if session[:show_pinyin] %>
    <p class="is-size-4 text-grey-light mt-0">
      <%= flashcard.pinyin %>
    </p>
  <% end %>

  <div class="flex flex--center flex--gap mt-5">
    <button
      type="button"
      class="button is-link"
      @click="window.dispatchEvent(new Event('review:toggle'))"
      x-text="answerVisible ? 'Hide answer' : 'Show answer'"
    ></button>
    <button type="button" class="button is-dark" data-action="click->review#speak">
      🔊 Speak
    </button>
  </div>
</div>