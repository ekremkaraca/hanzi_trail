<div class="review-empty-state box has-text-centered py-6">
  <div class="is-size-1 mb-4" aria-hidden="true">✓</div>

  <% if reviewed_count.to_i.positive? %>
    <h2 class="title is-3">Review session complete.</h2>
    <p class="subtitle is-5 mt-2">You reviewed <%= pluralize(reviewed_count, "card") %>.</p>
    <p class="has-text-grey">Good work. Your current review queue is clear.</p>

    <div class="buttons is-centered mt-5">
      <%= link_to "View stats", stats_path, class: "button is-link" %>
      <%= link_to "Start new session", review_path(review_filter_params.merge(reset_session: "1")), class: "button is-dark" %>
    </div>
  <% else %>
    <h2 class="title is-3"><%= empty_state_title || "No cards due right now" %></h2>
    <p class="has-text-grey mt-2">Review your flashcards later or browse all cards.</p>
  <% end %>

  <div class="mt-5">
    <%= link_to "Browse flashcards", flashcards_path, class: "button is-light" %>
  </div>
</div>
