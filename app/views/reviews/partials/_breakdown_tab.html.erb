<%# Locals: flashcard - the Flashcard instance %>
<div class="review-tab-panel-card">
  <div class="grid grid--2">
    <%# DRY: render inline label rows via shared partial, varying only attribute + label + color %>
    <%= render "reviews/partials/character_label", flashcard: flashcard, attribute: :components, label: "Components", color: "info" %>
    <%= render "reviews/partials/character_label", flashcard: flashcard, attribute: :literal_meaning, label: "Literal Meaning", color: "info" %>
    <%= render "reviews/partials/character_label", flashcard: flashcard, attribute: :mnemonic, label: "Memory Hook", color: "success", full_width: true %>
  </div>
</div>
