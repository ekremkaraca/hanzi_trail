<section class="section review-page">
  <div class="container is-max-widescreen">
    <div class="review-header">
      <div>
        <h1 class="title is-2">Review</h1>
        <p class="subtitle is-6 has-text-grey-light">
          Learn a little every day. You&apos;ve got this.
        </p>
      </div>

      <% if @remaining_due_count.present? %>
        <div class="review-count-box" aria-label="Cards remaining: <%= @remaining_due_count %>">
          <span class="has-text-grey-light">Cards remaining</span>
          <strong><%= @remaining_due_count %></strong>
        </div>
      <% end %>
    </div>

    <% if @flashcard.present? %>
      <div
        class="review-card box"
        data-controller="review"
        data-action="keydown@window->review#handleKeydown"
      >
        <div class="has-text-centered">
          <div class="review-mode-bar">
            <%= link_to "All", review_path, class: review_mode_button_class(:all) %>

            <%= link_to "HSK", review_path(source: "hsk"), class: review_mode_button_class(:hsk) %>

            <%= link_to "Curated", review_path(source: "curated"), class: review_mode_button_class(:curated) %>

            <%= link_to "Missing stories", review_path(story_status: "missing"), class: review_mode_button_class(:missing_stories) %>
          </div>

          <p class="review-progress-text">
            <%= review_progress_text(@reviewed_count, @remaining_due_count) %>
          </p>

          <h2 class="review-character">
            <%= @flashcard.character %>
          </h2>

          <button
            type="button"
            class="button is-link is-medium mt-5"
            data-review-target="showButton"
            data-action="click->review#toggleAnswer"
          >
            Show answer
          </button>
        </div>

        <div data-review-target="answer" hidden>
          <hr class="review-divider">

          <div class="review-answer has-text-centered">
            <p>
              <strong>Pinyin:</strong>
              <span class="has-text-grey-light"><%= @flashcard.pinyin %></span>
            </p>

            <p>
              <strong>Meaning:</strong>
              <span class="has-text-grey-light"><%= @flashcard.meaning %></span>
            </p>

            <% if @flashcard.story.present? %>
              <div class="content review-story">
                <%= simple_format(@flashcard.story) %>
              </div>
            <% end %>
          </div>

          <div class="review-buttons buttons is-centered mt-6">
            <%= button_to "Again [1]",
                  review_flashcard_path(@flashcard),
                  method: :patch,
                  params: { review: { rating: "again" }, source: params[:source], category: params[:category], story_status: params[:story_status] },
                  class: "button is-danger is-medium",
                  data: { review_rating: "1" } %>

            <%= button_to "Hard [2]",
                  review_flashcard_path(@flashcard),
                  method: :patch,
                  params: { review: { rating: "hard" }, source: params[:source], category: params[:category], story_status: params[:story_status] },
                  class: "button is-warning is-medium",
                  data: { review_rating: "2" } %>

            <%= button_to "Good [3]",
                  review_flashcard_path(@flashcard),
                  method: :patch,
                  params: { review: { rating: "good" }, source: params[:source], category: params[:category], story_status: params[:story_status] },
                  class: "button is-success is-medium",
                  data: { review_rating: "3" } %>

            <%= button_to "Easy [4]",
                  review_flashcard_path(@flashcard),
                  method: :patch,
                  params: { review: { rating: "easy" }, source: params[:source], category: params[:category], story_status: params[:story_status] },
                  class: "button is-info is-medium",
                  data: { review_rating: "4" } %>
          </div>

          <p class="has-text-centered has-text-grey-light is-size-7 mt-4">
            Use 1 · 2 · 3 · 4 keys for quick review
          </p>
        </div>
      </div>
    <% else %>
      <div class="box review-card has-text-centered">
        <% if @reviewed_count.positive? %>
          <h2 class="title is-4">Review session complete.</h2>
          <p class="has-text-grey-light mb-5">
            You reviewed <%= pluralize(@reviewed_count, "card") %>.
          </p>
        <% else %>
          <h2 class="title is-4"><%= @empty_state_title %></h2>
          <p class="has-text-grey-light mb-5">
            Review your flashcards later or browse all cards.
          </p>
        <% end %>

        <%= link_to "Browse flashcards", flashcards_path, class: "button is-link" %>
        <%= link_to "Start new session",
              review_path(@review_filter_params.merge(reset_session: "1")),
              class: "button is-light" %>
    <% end %>
  </div>
</section>
