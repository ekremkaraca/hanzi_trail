<!-- app/views/reviews/show.html.erb -->

<section class="section">
  <div class="container">
    <h1 class="title">Review</h1>

    <% if @flashcard.present? %>
      <div
        class="box has-text-centered"
        data-controller="review"
        data-action="keydown@window->review#handleKeydown"
      >
        <div class="box">
          <h2 class="title is-2">
            <%= @flashcard.character %>
          </h2>

          <button
            type="button"
            class="button is-link"
            data-action="click->review#showAnswer"
            data-review-target="showButton"
          >
            Show answer
          </button>

          <div data-review-target="answer" hidden>
            <hr />

            <p><strong>Pinyin:</strong> <%= @flashcard.pinyin %></p>
            <p><strong>Meaning:</strong> <%= @flashcard.meaning %></p>

            <% if @flashcard.story.present? %>
              <div class="content">
                <%= simple_format(@flashcard.story) %>
              </div>
            <% end %>

            <div class="buttons is-centered mt-4">
              <%= button_to "Again [1]",
                    review_flashcard_path(@flashcard),
                    method: :patch,
                    params: { review: { rating: "again" } },
                    class: "button is-danger",
                    data: { review_rating: "1" } %>

              <%= button_to "Hard [2]",
                    review_flashcard_path(@flashcard),
                    method: :patch,
                    params: { review: { rating: "hard" } },
                    class: "button is-warning",
                    data: { review_rating: "2" } %>

              <%= button_to "Good [3]",
                    review_flashcard_path(@flashcard),
                    method: :patch,
                    params: { review: { rating: "good" } },
                    class: "button is-success",
                    data: { review_rating: "3" } %>

              <%= button_to "Easy [4]",
                    review_flashcard_path(@flashcard),
                    method: :patch,
                    params: { review: { rating: "easy" } },
                    class: "button is-info",
                    data: { review_rating: "4" } %>
            </div>
            <p class="has-text-gray is-size-7 mt-3">
              Cards remaining: <%= @remaining_due_count %>
            </p>
        </div>
      </div>
    <% else %>
      <div class="notification is-info">
        No cards due right now.
      </div>

      <%= link_to "Browse flashcards", flashcards_path, class: "button is-light" %>
    <% end %>
  </div>
</section>
