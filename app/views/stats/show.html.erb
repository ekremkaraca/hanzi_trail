<section class="section stats-page">
  <div class="container is-max-widescreen">
    <h1 class="stats-heading">Stats</h1>

    <div class="stats-cards">
        <div class="stats-card">
          <span>Reviewed today</span>
          <strong><%= @today_count %></strong>
        </div>

        <div class="stats-card">
          <span>Last 7 days</span>
          <strong><%= @week_count %></strong>
        </div>

        <div class="stats-card">
          <span>Total reviews</span>
          <strong><%= @total_count %></strong>
        </div>

        <%# Surface the current streak next to the other headline stats. %>
        <div id="current-streak" class="stats-card">
          <span>Current streak</span>
          <strong><%= @streak %></strong>
        </div>

    </div>

    <div class="stats-section">
      <h2 class="stats-subheading">Rating breakdown</h2>

      <div class="stats-bars">
        <% %w[again hard good easy].each do |rating| %>
          <div class="stats-bar-row">
            <span class="stats-bar-label"><%= rating %></span>
            <div class="stats-bar-track">
              <div class="<%= bar_fill_class(rating) %>" style="--bar-width: <%= rating_bar_width(rating, @rating_breakdown) %>"></div>
            </div>
            <span class="stats-bar-count"><%= @rating_breakdown[rating] || 0 %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div id="rating-summary" class="stats-section">
      <h2 class="stats-subheading">Review counts by rating</h2>

      <div class="stats-cards">
        <% %w[again hard good easy].each do |rating| %>
          <div class="stats-card">
            <span class="stats-card-label"><%= rating.capitalize %></span>
            <strong class="stats-card-value"><%= @rating_breakdown[rating] || 0 %></strong>
          </div>
        <% end %>
      </div>
    </div>

    <div id="most-difficult" class="stats-section">
      <h2 class="stats-subheading">Most difficult</h2>

      <div class="stats-list">
        <% if @most_difficult_flashcards.any? %>
          <% @most_difficult_flashcards.each do |flashcard| %>
            <div class="stats-list-item">
              <span class="stats-list-character"><%= flashcard.character %></span>
              <span><%= flashcard.meaning %></span>
              <span class="stats-list-time">
                <%= pluralize(flashcard.difficult_review_count.to_i, "difficult review") %>
              </span>
            </div>
          <% end %>
        <% else %>
          <p class="stats-empty">No difficult cards yet.</p>
        <% end %>
      </div>
    </div>

    <div id="recently-reviewed" class="stats-section">
      <h2 class="stats-subheading">Recently reviewed</h2>

      <div class="stats-list">
        <% if @recent_attempts.any? %>
          <% @recent_attempts.first(3).each do |attempt| %>
            <div class="stats-list-item">
              <span class="stats-list-character"><%= attempt.flashcard.character %></span>
              <span class="<%= rating_badge_class(attempt.rating) %>"><%= attempt.rating %></span>
              <span class="stats-list-time"><%= time_ago_in_words(attempt.reviewed_at) %> ago</span>
            </div>
          <% end %>
        <% else %>
          <p class="stats-empty">No reviews yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</section>
