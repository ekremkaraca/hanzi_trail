<% flash.each do |type, message| %>
  <div class="flash-message is-<%= type %>"
    data-controller="flash"
    data-flash-timeout-value="4000"
    role="alert"
    aria-live="polite">
    <div class="flash-message-content">
      <span class="flash-message-icon">
        <%= type.to_s == "notice" ? "✓" : "!" %>
      </span>
      <span class="flash-message-text"><%= message %></span>
    </div>
    <button class="flash-message-close"
            data-action="click->flash#close"
            aria-label="Close">
            x
    </button>
  </div>
<% end %>
